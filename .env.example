# Backblaze B2 — create a least-privilege application key for the demo bucket.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_ENDPOINT=

# Genblaze providers — enable only the providers used by the final pipeline.
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=

# Application
TOLUVA_DEMO_MODE=true
TOLUVA_MAX_TIMING_RETRIES=2
TOLUVA_GREEN_DRIFT_THRESHOLD=0.08
TOLUVA_AMBER_DRIFT_THRESHOLD=0.15
