# Store the real file at /etc/toluva/worker.env with mode 0600.
# Never commit credential values.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=
ELEVENLABS_API_KEY=

TOLUVA_WORK_DIR=/var/lib/toluva
TOLUVA_WORKER_ALLOW_PROVIDER_SPEND=true
TOLUVA_WORKER_REPLICA_COUNT=1
TOLUVA_WORKER_POLL_SECONDS=5
TOLUVA_WORKER_HEARTBEAT_SECONDS=30
TOLUVA_WORKER_STALE_CLAIM_SECONDS=90
TOLUVA_MAX_TIMING_RETRIES=2
TOLUVA_GREEN_DRIFT_THRESHOLD=0.08
TOLUVA_AMBER_DRIFT_THRESHOLD=0.15
